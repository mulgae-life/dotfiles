# ─────────────────────────────────────────────
# Codex 실행 정책 (Execution Policy)
# approval_policy = "never" + sandbox_mode = "danger-full-access" 조합에서 파국형 명령만 차단
# (--full-auto는 0.147.0에서 제거됨. 우리는 permission profiles 대신 본 Starlark DSL로 직접 통제)
# 그 밖의 위험 명령(삭제, sudo, 권한 변경, 링크 강제, in-place 수정, Docker 삭제, Git·GitHub 쓰기)은
# Claude·Antigravity와 같이 AGENTS.md 지침으로 통제한다 — 사용자가 요청할 때만 실행한다.
# 규칙으로 막으면 사용자가 요청해도 실행하지 못하므로 파국형에만 쓴다.
# 카테고리 분류는 3-tool 공통 분류를 따름 (.antigravity/README.md "3-tool 정합성" 표)
# justification은 차단 시점에 사용자/에이전트에게 노출됨 → 대체 방법까지 안내
# ─────────────────────────────────────────────

# forbidden은 승인 경로가 없는 즉시 차단 → "승인 후 실행"이 아니라 "사용자가 직접 실행"으로 안내
_MSG_WIDE_DELETE = "루트·홈·현재 폴더를 통째로 지우는 명령은 차단됩니다. 지울 대상을 구체적인 경로로 좁히세요. 꼭 필요하면 사용자에게 직접 실행을 요청하세요."
_MSG_SYSTEM      = "전원 조작·디스크 파괴 명령은 차단됩니다. 환경 전체에 영향을 주므로 필요하면 사용자에게 직접 실행을 요청하세요."

# ── 넓은 재귀 삭제 (루트·홈·현재 폴더) ──
# prefix_rule은 토큰이 정확히 같을 때만 맞는다. `/home/user`처럼 더 깊은 경로는 맞추지 못하고,
# 변수의 확장 결과도 계산하지 않는다(`$HOME`이라는 문자열 자체만 맞춘다)
_RM_RF = ["-rf", "-fr", "-Rf", "-fR"]
_RM_R  = ["-r", "-R"]
_ROOTS = ["/", "/*", "/bin", "/boot", "/etc", "/home", "/lib", "/root", "/sbin", "/usr", "/var",
          "~", "~/", "~/*", "$HOME", ".", "./", "./*", "..", "../", "../*", "../.."]
prefix_rule(pattern = ["rm", _RM_RF, _ROOTS],                           decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["rm", _RM_R, "-f", _ROOTS],                      decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["rm", "-f", _RM_R, _ROOTS],                      decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["rm", "--recursive", "--force", _ROOTS],         decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["sudo", "rm", _RM_RF, _ROOTS],                   decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["sudo", "rm", _RM_R, "-f", _ROOTS],              decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["sudo", "rm", "-f", _RM_R, _ROOTS],              decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = ["sudo", "rm", "--recursive", "--force", _ROOTS], decision = "forbidden", justification = _MSG_WIDE_DELETE)

# Windows PowerShell — Codex가 PowerShell 스크립트를 명령 단위로 쪼개 대조한다
# 첫 토큰은 철자 그대로 대조한다(소문자·.exe 정규화는 절대경로 실행만). PowerShell은 대소문자를 가리지 않으므로
# 흔한 두 표기(정식·소문자)만 두며, 그 밖의 대소문자 조합은 막지 못한다
_PS_RM    = ["Remove-Item", "remove-item", "ri", "rm", "rmdir", "del", "erase", "rd"]
_PS_REC   = ["-Recurse", "-recurse", "-rec", "-r"]
_PS_FORCE = ["-Force", "-force", "-fo", "-f"]
_PS_PATH  = ["-Path", "-path", "-LiteralPath", "-literalpath"]
_PS_ROOTS = ["C:\\", "C:\\*", "C:/", "C:/*", "D:\\", "D:\\*", "D:/", "D:/*",
             "~", "~\\", "~\\*", "~/", "~/*", "$HOME", "$env:USERPROFILE",
             ".", ".\\", ".\\*", "./", "./*", "..", "..\\", "..\\*", "../", "../*"]
prefix_rule(pattern = [_PS_RM, _PS_REC, _PS_ROOTS],                      decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_REC, _PS_FORCE, _PS_ROOTS],           decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_FORCE, _PS_REC, _PS_ROOTS],           decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_ROOTS, _PS_REC],                      decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_ROOTS, _PS_FORCE, _PS_REC],           decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_PATH, _PS_ROOTS, _PS_REC],            decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_PATH, _PS_ROOTS, _PS_FORCE, _PS_REC], decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_REC, _PS_PATH, _PS_ROOTS],            decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_REC, _PS_FORCE, _PS_PATH, _PS_ROOTS], decision = "forbidden", justification = _MSG_WIDE_DELETE)
prefix_rule(pattern = [_PS_RM, _PS_FORCE, _PS_REC, _PS_PATH, _PS_ROOTS], decision = "forbidden", justification = _MSG_WIDE_DELETE)

# ── 전원 조작·디스크 파괴 ──
_POWER_MKFS = ["reboot", "shutdown", "poweroff", "halt", "mkfs",
               "mkfs.ext2", "mkfs.ext3", "mkfs.ext4", "mkfs.xfs", "mkfs.btrfs", "mkfs.vfat", "mkfs.fat", "mkfs.ntfs", "mkfs.exfat"]
prefix_rule(pattern = [_POWER_MKFS],         decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", _POWER_MKFS], decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["systemctl", ["reboot", "poweroff", "halt"]],         decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", "systemctl", ["reboot", "poweroff", "halt"]], decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["loginctl", ["reboot", "poweroff"]],                  decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", "loginctl", ["reboot", "poweroff"]],          decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["crontab", "-r"],                                     decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", "crontab", "-r"],                             decision = "forbidden", justification = _MSG_SYSTEM)

# 디스크 장치를 대상으로 한 dd·fdisk·parted·shred만 막는다. 일반 파일 복사(dd if=a of=b)나 조회(fdisk -l)는 막지 않는다.
# 글롭이 없어 흔한 장치 이름을 열거한다. 열거하지 않은 장치와, 장치가 첫 인자가 아닌 형태(dd if=x of=/dev/sda)는 맞추지 못한다
_SD_DISKS = ["/dev/sda", "/dev/sdb", "/dev/sdc", "/dev/sdd", "/dev/vda", "/dev/vdb", "/dev/hda"]
_NV_DISKS = ["/dev/nvme0n1", "/dev/nvme1n1", "/dev/mmcblk0"]
_PART_NO  = ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
_DEVICES  = (_SD_DISKS + _NV_DISKS
             + [d + n for d in _SD_DISKS for n in _PART_NO]
             + [d + "p" + n for d in _NV_DISKS for n in _PART_NO])
_DD_OF    = ["of=" + d for d in _DEVICES]
prefix_rule(pattern = [["fdisk", "parted", "shred"], _DEVICES],         decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", ["fdisk", "parted", "shred"], _DEVICES], decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["dd", _DD_OF],                                   decision = "forbidden", justification = _MSG_SYSTEM)
prefix_rule(pattern = ["sudo", "dd", _DD_OF],                           decision = "forbidden", justification = _MSG_SYSTEM)
# Windows PowerShell — 전원 조작·디스크 파괴. 확장자를 붙인 호출은 이름이 달라 따로 둔다
prefix_rule(
    pattern = [["Stop-Computer", "stop-computer", "Restart-Computer", "restart-computer",
                "Format-Volume", "format-volume", "Clear-Disk", "clear-disk",
                "Remove-Partition", "remove-partition", "diskpart", "diskpart.exe", "shutdown.exe"]],
    decision = "forbidden",
    justification = _MSG_SYSTEM
)

# ── 프로세스 종료: allow ──
# 재시작 가능한 조작이라 파일 삭제와 위험 등급이 다름 (v2.2에서 ask 해제)
prefix_rule(pattern = ["kill"],    decision = "allow")
prefix_rule(pattern = ["pkill"],   decision = "allow")
prefix_rule(pattern = ["killall"], decision = "allow")

# ── Git 읽기 명령은 허용 ──
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "blame", "fetch", "remote", "branch", "tag"]],
    decision = "allow"
)

# ── GitHub CLI 읽기는 허용 ──
prefix_rule(
    pattern = ["gh", ["pr", "issue", "release", "repo"], ["list", "view", "status", "checks", "diff"]],
    decision = "allow"
)
